# Copia este archivo como .env (el .env NO se sube a GitHub).

# SQL Server exige: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Cambia_Esta_Clave_2026!

# Llave para firmar los JWT de la API en Docker (mínimo 32 caracteres). Cámbiala por una aleatoria.
JWT_LLAVE=cambia-esta-llave-por-una-aleatoria-de-64-caracteres-0123456789
